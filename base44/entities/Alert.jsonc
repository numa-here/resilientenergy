{
  "name": "Alert",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Geopolitical",
        "Sanctions",
        "Shipping",
        "Route Closure",
        "Supplier Risk",
        "Price Shock",
        "Weather"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Critical"
      ]
    },
    "source": {
      "type": "string"
    },
    "affected_assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_score": {
      "type": "number"
    },
    "impact_assessment": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "Acknowledged",
        "Investigating",
        "Resolved"
      ],
      "default": "Active"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "severity"
  ]
}
