{
  "name": "Scenario",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "disruption_type": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Critical"
      ]
    },
    "duration_days": {
      "type": "number"
    },
    "affected_corridor": {
      "type": "string"
    },
    "affected_supplier": {
      "type": "string"
    },
    "reduction_pct": {
      "type": "number"
    },
    "results": {
      "type": "object"
    },
    "is_demo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "disruption_type"
  ]
}
