{
  "name": "Recommendation",
  "type": "object",
  "properties": {
    "supplier": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "quantity_pct": {
      "type": "number"
    },
    "additional_cost_per_barrel": {
      "type": "number"
    },
    "delivery_time_days": {
      "type": "number"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Critical"
      ]
    },
    "reliability_score": {
      "type": "number"
    },
    "score": {
      "type": "number"
    },
    "reasoning": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    }
  },
  "required": [
    "supplier"
  ]
}
